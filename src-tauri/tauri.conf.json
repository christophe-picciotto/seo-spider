{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SEO Spider",
  "version": "0.1.0",
  "identifier": "app.seospider.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SEO Spider",
        "width": 1100,
        "height": 800,
        "minWidth": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "French",
          "Spanish",
          "German",
          "Italian",
          "Portuguese",
          "PortugueseBR",
          "Polish",
          "Dutch",
          "Turkish",
          "Russian",
          "Japanese"
        ],
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "Polish": "installer/Polish.nsh"
        }
      }
    }
  }
}
